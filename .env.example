# Copy to .env.local and fill in. Never commit real values (.env* is git-ignored).
#
# WARNING: Next.js loads .env.local, vitest does not. With a MODEL_API_KEY in .env.local,
# `npm run dev` calls the real (paid) Muse and SAM. To work in demo mode anyway, run
# `npm run dev:demo` (it empties the variables for that process).

# Meta Model API key (Bearer). Empty = the app runs in explicit DEMO MODE with a mock provider.
MODEL_API_KEY=

# OpenAI-compatible Meta Model API endpoint. Model id is fixed in code to "muse-spark-1.3"
# (Standard mode). NEVER use a "-contributor" model id: Meta trains on that traffic.
MODEL_BASE_URL=https://api.meta.ai/v1
# Optional reasoning effort for Muse Spark: minimal | low | medium | high | xhigh | max.
MODEL_REASONING_EFFORT=

# Open-weights engine ("Run privately"). Two ways to set it up, pick ONE.
#
# (A) Muse Spark Open on Baseten Model APIs (the hackathon open-weights prize path).
#     Set OPEN_WEIGHTS_PROVIDER=baseten and BASETEN_API_KEY; nothing else is needed. The base URL
#     is https://inference.baseten.co/v1 and the model defaults to the slug of the hackathon guide.
#     Check it with: npm run probe -- open-weights --models --chat   (see deploy/README.md).
OPEN_WEIGHTS_PROVIDER=
BASETEN_API_KEY=
# Optional: another model slug if Baseten's /v1/models lists a different one. Baseten's public docs
# list meta-models/muse-spark-open; the hackathon guide says meta-models/muse-spark-open-1026
# (the default here).
BASETEN_MODEL=
#
# (B) Any other OpenAI-compatible server: Muse Glimmer on Modal (deploy/modal_glimmer.py), or Muse
#     Spark Open on another provider. Leave OPEN_WEIGHTS_PROVIDER empty (or "modal"/"custom").
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=
# Modal proxy-auth token pair (https://modal.com/settings/proxy-auth-tokens). The Glimmer
# server is published with requires_proxy_auth=True: without these two values every request
# gets a 401. See deploy/README.md.
OPEN_WEIGHTS_PROXY_KEY=
OPEN_WEIGHTS_PROXY_SECRET=
#
# Both ways. Reasoning depth: low | medium | high | xhigh. On Baseten it is the reasoning_effort
# request field (default medium here; Baseten's own default is xhigh, which is slow). On the
# Modal/Glimmer server it is a "Reasoning strength" line in the system prompt.
OPEN_WEIGHTS_REASONING_STRENGTH=
# Set to 0 if the open-weights model cannot read images: the agent then does NOT send the photos,
# says so in the trace and sends every case to a human. Unset means the model reads them.
OPEN_WEIGHTS_VISION=

# OpenRouter TEST engine (cheap bulk runs). Never private, never the default: the photos and the
# message go to OpenRouter and Meta. It only appears on the report screen when this key is set.
# The model is Standard mode only: a "-contributor" id is refused in code.
OPENROUTER_API_KEY=
# Optional, default meta/muse-spark-1.3.
OPENROUTER_MODEL=

# SAM 3.1 (damage localisation) endpoint, if different from MODEL_BASE_URL.
SAM_BASE_URL=

# Optional Shopify dev store (read_orders only). Empty = fictitious orders from
# data/fixtures/orders.json.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Merchant identity printed on the carrier claim PDF and e-mail (demo defaults if empty).
MERCHANT_NAME=
MERCHANT_ADDRESS=
MERCHANT_EMAIL=

# PUBLIC DEPLOYMENT (the URL given to the judges). Never type real customer data there.
# Shared demo code. When set, EVERY new report (demo mode included), every voice dictation and every
# approve/edit/reject needs it (401 without it); the recorded runs stay visible to everyone. After
# 10 wrong codes in 10 minutes from one client the code is refused with a 429. Because it can be
# guessed by a loop, make it random and at least 16 characters, for example:
#   openssl rand -base64 18
# Empty = no check (local use).
DAMAGE_DESK_ACCESS_CODE=
# Ceiling of REAL model runs per day and per server instance (default 100). Beyond it,
# reports run in labelled DEMO MODE instead of failing.
DAMAGE_DESK_REAL_RUNS_PER_DAY=

# STORAGE. Empty or "file" (default): cases and their files are local files under the runtime
# folder (data/runtime locally, /tmp on Vercel, where they belong to one serverless instance).
# "blob": a PRIVATE Vercel Blob store shared by every instance (docs/storage.md). On Vercel it
# authenticates with BLOB_STORE_ID + the injected OIDC token; elsewhere set BLOB_READ_WRITE_TOKEN.
DAMAGE_DESK_STORAGE=
BLOB_READ_WRITE_TOKEN=
