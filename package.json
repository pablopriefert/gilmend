{
  "name": "gilmend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Gilmend: broken parcels, mended in gold. The agent that prepares the claim to recover the money from damaged parcels (Meta Global AI Developer Hackathon, Startups track).",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "MODEL_API_KEY= OPEN_WEIGHTS_BASE_URL= OPEN_WEIGHTS_MODEL= BASETEN_API_KEY= OPENROUTER_API_KEY= next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "start:demo": "MODEL_API_KEY= OPEN_WEIGHTS_BASE_URL= OPEN_WEIGHTS_MODEL= BASETEN_API_KEY= OPENROUTER_API_KEY= next start",
    "real": "tsx --env-file=.env.local scripts/run-real.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "real:follow-up": "tsx --env-file=.env.local scripts/run-real-follow-up.ts",
    "probe": "tsx --env-file=.env.local scripts/probe-engine.ts",
    "sam-probe": "tsx --env-file=.env.local scripts/sam-probe.ts",
    "sweep": "tsx --env-file=.env.local scripts/run-sweep.ts",
    "showcase:build": "tsx scripts/build-showcase.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "@vercel/blob": "2.8.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.1",
    "openai": "7.32.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "zod": "4.6.7",
    "undici@^6": "6.29.1"
  }
}
